APP_ENV=local
APP_SECRET_KEY=change-me-in-production
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3001
DATABASE_URL=sqlite:///./appsec.db
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=appsec
MINIO_SECRET_KEY=appsec_dev_password
MINIO_BUCKET=appsec-evidence
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=qwen35-hauhau-q4:latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
USE_LLM_PLANNER=false
SANDBOX_MODE=docker
SANDBOX_DEFAULT_NETWORK_EGRESS=false
SANDBOX_MAX_CPU=2
SANDBOX_MAX_MEMORY_MB=4096
SANDBOX_DEFAULT_TIMEOUT_SECONDS=1800
DEFAULT_SCAN_PROFILE=safe-active
ALLOW_PUBLIC_TARGETS=false
REQUIRE_SCOPE_FILE=true
